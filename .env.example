# ==============================================================================
# ReRAG Environment Configuration
# Copy this file to '.env' and update the values as needed.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Document Processing & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_UNIT=tokens
CHUNK_SEPARATORS=["\n\n", "\n", " ", ""]

# Embeddings & Inference Hardware
# Model: 'all-MiniLM-L6-v2' (default) or other HuggingFace SentenceTransformer model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Device: 'cpu' for CPU-friendly execution, or 'cuda'/'mps' if hardware acceleration is available
DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Vector Storage (ChromaDB)
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=rerag_collection

# Retrieval Settings
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.3

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_REQUEST_TIMEOUT=60

# Deterministic Evaluation & Inference Settings
TEMPERATURE=0.0
RANDOM_SEED=42
DETERMINISTIC_MODE=True

# ReRAG Architecture Specific Parameters
MAX_REFINEMENT_STEPS=3
VERIFICATION_THRESHOLD=0.7

# Storage Paths (Relative to project root or absolute)
DATA_DIR=data
DOCUMENTS_DIR=data/documents
EVALUATION_DIR=data/evaluation
RESULTS_DIR=results
